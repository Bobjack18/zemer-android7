@@ -0,0 +1,67 @@
+package com.jtech.zemer.utils.updater
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Pure coverage of the automatic update-check policy: how many attempts one round makes, and when
+ * a return to the foreground may start a new one.
+ */
+class AutoUpdatePolicyTest {
+
+    @Test
+    fun `a round retries until the attempt budget is spent`() {
+        assertTrue(AutoUpdatePolicy.shouldRetry(1))
+        assertTrue(AutoUpdatePolicy.shouldRetry(AutoUpdatePolicy.MAX_ATTEMPTS - 1))
+        assertFalse(AutoUpdatePolicy.shouldRetry(AutoUpdatePolicy.MAX_ATTEMPTS))
+        assertFalse(AutoUpdatePolicy.shouldRetry(AutoUpdatePolicy.MAX_ATTEMPTS + 1))
+    }
+
+    @Test
+    fun `a foreground return rechecks while no check has completed`() {
+        assertTrue(AutoUpdatePolicy.shouldRecheckOnResume(0L, 1_000L))
+    }
+
+    @Test
+    fun `a foreground return rechecks only after the interval`() {
+        val last = 10_000L
+        assertFalse(
+            AutoUpdatePolicy.shouldRecheckOnResume(
+                last,
+                last + AutoUpdatePolicy.RESUME_RECHECK_INTERVAL_MS - 1,
+            ),
+        )
+        assertTrue(
+            AutoUpdatePolicy.shouldRecheckOnResume(
+                last,
+                last + AutoUpdatePolicy.RESUME_RECHECK_INTERVAL_MS,
+            ),
+        )
+    }
+
+    @Test
+    fun `a failed download is retried until the attempt budget is spent`() {
+        assertTrue(AutoUpdatePolicy.shouldRetryDownload(1, UpdateDownloadFailure.NETWORK))
+        assertTrue(AutoUpdatePolicy.shouldRetryDownload(1, UpdateDownloadFailure.MEMORY))
+        assertTrue(
+            AutoUpdatePolicy.shouldRetryDownload(
+                AutoUpdatePolicy.MAX_DOWNLOAD_ATTEMPTS - 1,
+                UpdateDownloadFailure.TIMEOUT,
+            ),
+        )
+        assertFalse(
+            AutoUpdatePolicy.shouldRetryDownload(
+                AutoUpdatePolicy.MAX_DOWNLOAD_ATTEMPTS,
+                UpdateDownloadFailure.NETWORK,
+            ),
+        )
+    }
+
+    @Test
+    fun `a corrupt artifact is never retried`() {
+        assertFalse(
+            AutoUpdatePolicy.shouldRetryDownload(1, UpdateDownloadFailure.CORRUPT_ARTIFACT),
+        )
+    }
+}
