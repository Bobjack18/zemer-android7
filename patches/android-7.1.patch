+package com.jtech.zemer.utils.updater
+
+import android.content.Context
+import com.jtech.zemer.utils.UpdateChecker
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flow
+
+/**
+ * The update download, with automatic retries.
+ *
+ * A detected build downloads on its own (the dialog only shows the progress), so a failed
+ * transfer must not end the story with the user staring at an error: the download is retried a
+ * couple of times. That covers the failures a small-RAM device hits - a dropped connection, or a
+ * heap exhausted mid-transfer - which usually clear by the time the next attempt starts. A corrupt
+ * artifact is never retried (the bytes on the wire do not match the announced build).
+ *
+ * The retry decision itself is pure policy ([AutoUpdatePolicy.shouldRetryDownload]); this is the
+ * thin flow that applies it.
+ */
+fun downloadUpdateWithRetries(
+    context: Context,
+    nightly: Boolean = false,
+): Flow<UpdateChecker.DownloadState> = flow {
+    var attempts = 0
+    while (true) {
+        attempts += 1
+        var failure: UpdateChecker.DownloadState.Error? = null
+        UpdateChecker.downloadUpdate(context, nightly).collect { state ->
+            if (state is UpdateChecker.DownloadState.Error) failure = state
+            emit(state)
+        }
+        val error = failure ?: return@flow // downloaded successfully
+        if (!AutoUpdatePolicy.shouldRetryDownload(attempts, error.failure)) return@flow
+        delay(AutoUpdatePolicy.DOWNLOAD_RETRY_DELAY_MS)
+    }
+}
