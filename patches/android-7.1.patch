@@ -0,0 +1,51 @@
+package com.jtech.zemer.utils.updater
+
+/**
+ * When the automatic update check runs, and how a failed attempt is retried.
+ *
+ * A cold-start check often runs before the network is usable (the device just woke, Wi-Fi is still
+ * associating, DNS is cold): the check then fails, and because a failed check is not an update,
+ * the session would end with nothing offered until the next launch. So a failed attempt is retried
+ * a couple of times, and every return to the foreground may start a fresh round - the throttle is
+ * based on the last check that actually COMPLETED, so a failed round never silences the next one.
+ *
+ * Pure policy, unit-tested.
+ */
+object AutoUpdatePolicy {
+    /** Attempts in one round: the first try plus two retries. */
+    const val MAX_ATTEMPTS = 3
+
+    /** Pause between a failed attempt and the next one. */
+    const val RETRY_DELAY_MS = 30_000L
+
+    /** Minimum gap between two rounds started by the app returning to the foreground. */
+    const val RESUME_RECHECK_INTERVAL_MS = 15 * 60 * 1000L
+
+    /** Whether another attempt follows after [attempts] failed attempts (1-based). */
+    fun shouldRetry(attempts: Int): Boolean = attempts < MAX_ATTEMPTS
+
+    /**
+     * Whether a foreground return may start a new round. [lastCompletedAtMs] is the time of the
+     * last check that produced a definitive answer (0 = none yet): a session whose checks all
+     * failed must be allowed to try again immediately.
+     */
+    fun shouldRecheckOnResume(lastCompletedAtMs: Long, nowMs: Long): Boolean =
+        lastCompletedAtMs <= 0L || nowMs - lastCompletedAtMs >= RESUME_RECHECK_INTERVAL_MS
+
+    /** Attempts in one download round: the first try plus two retries. */
+    const val MAX_DOWNLOAD_ATTEMPTS = 3
+
+    /** Pause between a failed download attempt and the next one. */
+    const val DOWNLOAD_RETRY_DELAY_MS = 30_000L
+
+    /**
+     * Whether the download is retried after [attempts] failed attempts (1-based).
+     *
+     * A corrupt artifact is never retried: the announced build and the bytes on the wire do not
+     * match, and the same request would fetch the same wrong bytes. Every other failure is worth
+     * another try - a dropped connection or an exhausted heap (a small-RAM device) usually clears
+     * by the time the next attempt starts.
+     */
+    fun shouldRetryDownload(attempts: Int, failure: UpdateDownloadFailure): Boolean =
+        attempts < MAX_DOWNLOAD_ATTEMPTS && failure != UpdateDownloadFailure.CORRUPT_ARTIFACT
+}
